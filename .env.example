# ==============================================================================
# LLM Provider Configuration
# Choose ONE or more providers below.
# If no API key is provided, the assistant runs in offline Mock Mode automatically.
# ==============================================================================

# Option 1: OpenAI (Default)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Groq (Free high-speed open models)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Custom OpenAI-compatible endpoint (Ollama / Local)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
